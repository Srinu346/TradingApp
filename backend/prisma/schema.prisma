generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  username  String   @unique
  firstName String   @default("User")
  lastName  String   @default("User")
  balance   Float    @default(0)
  createdAt DateTime @default(now())
  stocks    Stocks[]
  orders    Orders[]
}

model Stocks {
  id       Int    @id @default(autoincrement())
  symbol   String
  name     String
  avgprice Float
  quantity Int
  userId   String
  user     User   @relation(fields: [userId], references: [username], onDelete: Cascade)
}

model MasterStocks {
  id           Int    @id @default(autoincrement())
  symbol       String @unique
  name         String
  currentPrice Float
  type         String
  market       String @default("NSE")
  priceHistory Json?  @default("[]")
}

model Orders {
  id          Int   @id  @default(autoincrement())
  userId      String
  user        User   @relation(fields: [userId], references: [username], onDelete: Cascade)
  symbol      String
  name        String
  quantity    Int
  price       Float
  type        String
  createdAt   DateTime @default(now())
}